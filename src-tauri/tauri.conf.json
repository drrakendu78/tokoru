{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokoru",
  "version": "0.1.0",
  "identifier": "com.startrad.tokoru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tokoru",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "backgroundColor": "#111113",
        "additionalBrowserArgs": "--ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy --enable-features=D3D11VideoDecoder"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
